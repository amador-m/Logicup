# =====================================================================
# LogiCup — MODELO das variáveis de produção. Este arquivo NÃO tem valores reais e pode ir para o Git.
#
# O arquivo de verdade se chama ".env", fica SÓ na VM (deploy/app/.env) e é criado pelo instalar.sh,
# que gera as senhas e a chave do JWT aleatoriamente. Ninguém precisa digitar nem saber essas senhas.
# O .env está no .gitignore: NUNCA o copie para o GitHub, para o chat ou para um print.
# =====================================================================

# Domínio público (sem https://). O Caddy pede o certificado HTTPS para ele e para www.<domínio>.
DOMINIO=logicup.dev.br
# E-mail que o Let's Encrypt usa para avisar sobre o certificado (ex.: se a renovação falhar)
ACME_EMAIL=logicup.oficial@gmail.com

# Senha do root do MySQL: usada só por você (migrações) e pelo backup. O backend NÃO a usa.
MYSQL_ROOT_PASSWORD=gerada-pelo-instalar.sh
# Senha do usuário logicup_app (o único que o backend usa; só lê e grava dados)
DB_APP_PASSWORD=gerada-pelo-instalar.sh
# Chave que assina os tokens de login (JWT). Se mudar, todo mundo precisa entrar de novo.
JWT_SECRET=gerada-pelo-instalar.sh

# Endereço INTERNO da VM do Piston (rede privada do Google Cloud, ex.: http://10.10.0.3:2000)
EXECUTOR_URL=http://IP-INTERNO-DO-PISTON:2000
# false = desliga a execução de código (o LogiCup corrige por palavras-chave e avisa o aluno)
EXECUTOR_HABILITADO=true
